{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "https_1080": {
        "Url": "https://*:1080"
      },
      "http_2080": {
        "Url": "http://192.168.1.102:2080"
      },
      "http_3080": {
        "Url": "http://192.168.1.103:3080"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "http_1080": {
        "ClusterId": "cluster_2080",
        "Match": {
          "Path": "{**catch-all}",
          "Hosts": [
            "localhost:1080",
            "127.0.0.1:1080",
            "192.168.1.102:1080",
            "192.168.1.103:1080"
          ]
        },
        "Transforms": [
          {
            "X-Forwarded": "Append",
            "For": "Append",
            "Proto": "Append",
            "Host": "Append",
            "Prefix": "Append",
            "HeaderPrefix": "X-Forwarded-"
          }
          //{
          //  "Forwarded": "by,for,host,proto",
          //  "ByFormat": "Random",
          //  "ForFormat": "IpAndPort",
          //  "Action": "Append"
          //}
        ]
      },
      "http_2080": {
        "ClusterId": "cluster_3080",
        "Match": {
          "Path": "{**catch-all}",
          "Hosts": [
            "192.168.1.102:2080"
          ]
        },
        "Transforms": [
          {
            "X-Forwarded": "Append",
            "For": "Append",
            "Proto": "Append",
            "Host": "Append",
            "Prefix": "Append",
            "HeaderPrefix": "X-Forwarded-"
          }
          //{
          //  "Forwarded": "by,for,host,proto",
          //  "ByFormat": "Random",
          //  "ForFormat": "IpAndPort",
          //  "Action": "Append"
          //}
        ]
      },
      "http_3080": {
        "ClusterId": "cluster_backend",
        "Match": {
          "Path": "{**catch-all}",
          "Hosts": [
            "192.168.1.103:3080"
          ]
        },
        "Transforms": [
          {
            "X-Forwarded": "Append",
            "For": "Append",
            "Proto": "Append",
            "Host": "Append",
            "Prefix": "Append",
            "HeaderPrefix": "X-Forwarded-"
          }
          //{
          //  "Forwarded": "by,for,host,proto",
          //  "ByFormat": "Random",
          //  "ForFormat": "IpAndPort",
          //  "Action": "Append"
          //}
        ]
      }
    },
    "Clusters": {
      "cluster_2080": {
        "Destinations": {
          "proxy2": {
            "Address": "http://192.168.1.102:2080"
          }
        }
      },
      "cluster_3080": {
        "Destinations": {
          "proxy3": {
            "Address": "http://192.168.1.103:3080"
          }
        }
      },
      "cluster_backend": {
        "Destinations": {
          "ApiSample": {
            "Address": "http://192.168.1.104:5000"
          }
        }
      }
    }
  }
}
